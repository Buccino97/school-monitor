{
  "manifest_version": 3,
  "name": "School Monitor Agent",
  "version": "2.0.0",
  "description": "Agent studente per School Monitor Cloud",
  "permissions": ["tabs","activeTab","storage","windows","alarms","declarativeNetRequest","webNavigation","tabCapture","offscreen","notifications","identity"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }],
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "128": "icon.png" },
  "web_accessible_resources": [{ "resources": ["blocked.html","lock.html"], "matches": ["<all_urls>"] }]
}
